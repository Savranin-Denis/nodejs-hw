{
  "openapi": "3.0.3",
  "info": {
    "title": "nodejs-hw",
    "version": "1.0.0",
    "license": {
      "name": "ISC",
      "url": "https://opensource.org/licenses/ISC"
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Notes",
      "description": "Notes endpoints."
    }
  ],
  "paths": {
    "/notes": {
      "get": {
        "tags": [
          "Notes"
        ],
        "summary": "Retrieve all notes",
        "description": "Returns a paginated list of notes stored in the database. Results can be filtered by tag and search text.",
        "operationId": "getNotes",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "The page number.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "required": false,
            "description": "The number of notes per page.",
            "schema": {
              "type": "integer",
              "minimum": 5,
              "maximum": 20,
              "default": 10
            }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "Filters notes by tag.",
            "schema": {
              "type": "string",
              "enum": [
                "Work",
                "Personal",
                "Meeting",
                "Shopping",
                "Ideas",
                "Travel",
                "Finance",
                "Health",
                "Important",
                "Todo"
              ]
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Filters notes by matching text in title or content.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Notes retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotesResponse"
                },
                "example": {
                  "page": 1,
                  "perPage": 10,
                  "totalNotes": 1,
                  "totalPages": 1,
                  "notes": [
                    {
                      "_id": "507f1f77bcf86cd799439011",
                      "title": "Project planning",
                      "content": "Prepare the project plan",
                      "tag": "Work",
                      "createdAt": "2024-01-01T00:00:00.000Z",
                      "updatedAt": "2024-01-01T00:00:00.000Z"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The query parameters failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Notes"
        ],
        "summary": "Create a note",
        "description": "Creates and returns a note.",
        "operationId": "createNote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNoteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Note created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request body failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/notes/{noteId}": {
      "get": {
        "tags": [
          "Notes"
        ],
        "summary": "Retrieve a note by ID",
        "description": "Returns the requested note.",
        "operationId": "getNoteById",
        "parameters": [
          {
            "name": "noteId",
            "in": "path",
            "required": true,
            "description": "The MongoDB ObjectId of the note to retrieve. Validated with mongoose.isValidObjectId.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Note retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteResponse"
                },
                "example": {
                  "_id": "507f1f77bcf86cd799439011",
                  "title": "Project planning",
                  "content": "Prepare the project plan",
                  "tag": "Work",
                  "createdAt": "2024-01-01T00:00:00.000Z",
                  "updatedAt": "2024-01-01T00:00:00.000Z"
                }
              }
            }
          },
          "400": {
            "description": "The note ID failed ObjectId validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No note exists with the requested ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Note not found"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Notes"
        ],
        "summary": "Delete a note",
        "description": "Deletes and returns the requested note.",
        "operationId": "deleteNote",
        "parameters": [
          {
            "name": "noteId",
            "in": "path",
            "required": true,
            "description": "The MongoDB ObjectId of the note to delete. Validated with mongoose.isValidObjectId.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Note deleted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteResponse"
                }
              }
            }
          },
          "400": {
            "description": "The note ID failed ObjectId validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No note exists with the requested ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Note not found"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "patch": {
        "tags": [
          "Notes"
        ],
        "summary": "Update a note",
        "description": "Updates and returns the requested note. Mongoose update validators are not enabled.",
        "operationId": "updateNote",
        "parameters": [
          {
            "name": "noteId",
            "in": "path",
            "required": true,
            "description": "The MongoDB ObjectId of the note to update. Validated with mongoose.isValidObjectId.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateNoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Note updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteResponse"
                }
              }
            }
          },
          "400": {
            "description": "The note ID or request body failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No note exists with the requested ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Note not found"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NotesResponse": {
        "type": "object",
        "required": [
          "page",
          "perPage",
          "totalNotes",
          "totalPages",
          "notes"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "perPage": {
            "type": "integer",
            "minimum": 5,
            "maximum": 20,
            "example": 10
          },
          "totalNotes": {
            "type": "integer",
            "minimum": 0,
            "example": 1
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0,
            "example": 1
          },
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoteResponse"
            }
          }
        }
      },
      "NoteResponse": {
        "type": "object",
        "required": [
          "_id",
          "title",
          "content",
          "tag",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          },
          "title": {
            "type": "string",
            "example": "Project planning"
          },
          "content": {
            "type": "string",
            "example": "Prepare the project plan"
          },
          "tag": {
            "type": "string",
            "enum": [
              "Work",
              "Personal",
              "Meeting",
              "Shopping",
              "Ideas",
              "Travel",
              "Finance",
              "Health",
              "Important",
              "Todo"
            ],
            "example": "Work"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-01T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-01T00:00:00.000Z"
          }
        }
      },
      "CreateNoteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Required; leading and trailing whitespace is trimmed.",
            "example": "Project planning"
          },
          "content": {
            "type": "string",
            "description": "Leading and trailing whitespace is trimmed.",
            "default": "",
            "example": "Prepare the project plan"
          },
          "tag": {
            "type": "string",
            "enum": [
              "Work",
              "Personal",
              "Meeting",
              "Shopping",
              "Ideas",
              "Travel",
              "Finance",
              "Health",
              "Important",
              "Todo"
            ],
            "default": "Todo",
            "example": "Work"
          }
        }
      },
      "UpdateNoteRequest": {
        "type": "object",
        "description": "Fields are optional. The route does not enable Mongoose update validators, so model validation rules such as the tag enum are not enforced.",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "example": "Project planning"
          },
          "content": {
            "type": "string",
            "example": "Prepare the project plan"
          },
          "tag": {
            "type": "string",
            "enum": [
              "Work",
              "Personal",
              "Meeting",
              "Shopping",
              "Ideas",
              "Travel",
              "Finance",
              "Health",
              "Important",
              "Todo"
            ],
            "example": "Work"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "InternalServerError": {
        "description": "The app-level error handler encountered an error. In production, the message is replaced by a generic error message.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}
