{
  "openapi": "3.0.3",
  "info": {
    "title": "nodejs-hw",
    "version": "1.0.0",
    "license": {
      "name": "ISC",
      "url": "https://opensource.org/licenses/ISC"
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentication endpoints."
    },
    {
      "name": "Notes",
      "description": "Notes endpoints."
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a user",
        "description": "Creates a user and a session.",
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully.",
            "headers": {
              "Set-Cookie": {
                "description": "Sets accessToken, refreshToken, and sessionId cookies.",
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation or the email is already in use.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "emailInUse": {
                    "value": {
                      "message": "Email in use"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in a user",
        "description": "Authenticates a user and creates a session.",
        "operationId": "loginUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User logged in successfully.",
            "headers": {
              "Set-Cookie": {
                "description": "Sets accessToken, refreshToken, and sessionId cookies.",
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Invalid credentials"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Refresh a user session",
        "description": "Replaces the current session using the session ID and refresh token cookies.",
        "operationId": "refreshUserSession",
        "parameters": [
          {
            "name": "sessionId",
            "in": "cookie",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "refreshToken",
            "in": "cookie",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session refreshed successfully.",
            "headers": {
              "Set-Cookie": {
                "description": "Sets replacement accessToken, refreshToken, and sessionId cookies.",
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                },
                "example": {
                  "message": "Session refreshed"
                }
              }
            }
          },
          "401": {
            "description": "The session was not found or the refresh token has expired.",
            "headers": {
              "Set-Cookie": {
                "description": "Expired sessions clear accessToken, refreshToken, and sessionId cookies.",
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log out a user",
        "description": "Deletes the current session and clears authentication cookies.",
        "operationId": "logoutUser",
        "parameters": [
          {
            "name": "sessionId",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "User logged out successfully.",
            "headers": {
              "Set-Cookie": {
                "description": "Clears accessToken, refreshToken, and sessionId cookies.",
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/notes": {
      "get": {
        "tags": [
          "Notes"
        ],
        "summary": "Retrieve all notes",
        "description": "Returns a paginated list of notes stored in the database. Results can be filtered by tag and search text.",
        "operationId": "getNotes",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "The page number.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "required": false,
            "description": "The number of notes per page.",
            "schema": {
              "type": "integer",
              "minimum": 5,
              "maximum": 20,
              "default": 10
            }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "Filters notes by tag.",
            "schema": {
              "type": "string",
              "enum": [
                "Work",
                "Personal",
                "Meeting",
                "Shopping",
                "Ideas",
                "Travel",
                "Finance",
                "Health",
                "Important",
                "Todo"
              ]
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Filters notes by matching text in title or content.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Notes retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotesResponse"
                },
                "example": {
                  "page": 1,
                  "perPage": 10,
                  "totalNotes": 1,
                  "totalPages": 1,
                  "notes": [
                    {
                      "_id": "507f1f77bcf86cd799439011",
                      "title": "Project planning",
                      "content": "Prepare the project plan",
                      "tag": "Work",
                      "userId": "507f1f77bcf86cd799439012",
                      "createdAt": "2024-01-01T00:00:00.000Z",
                      "updatedAt": "2024-01-01T00:00:00.000Z"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The query parameters failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "The access token is missing, unknown, or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Notes"
        ],
        "summary": "Create a note",
        "description": "Creates and returns a note.",
        "operationId": "createNote",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNoteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Note created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request body failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "The access token is missing, unknown, or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/notes/{noteId}": {
      "get": {
        "tags": [
          "Notes"
        ],
        "summary": "Retrieve a note by ID",
        "description": "Returns the requested note.",
        "operationId": "getNoteById",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "noteId",
            "in": "path",
            "required": true,
            "description": "The MongoDB ObjectId of the note to retrieve. Validated with mongoose.isValidObjectId.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Note retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteResponse"
                },
                "example": {
                  "_id": "507f1f77bcf86cd799439011",
                  "title": "Project planning",
                  "content": "Prepare the project plan",
                  "tag": "Work",
                  "userId": "507f1f77bcf86cd799439012",
                  "createdAt": "2024-01-01T00:00:00.000Z",
                  "updatedAt": "2024-01-01T00:00:00.000Z"
                }
              }
            }
          },
          "400": {
            "description": "The note ID failed ObjectId validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "The access token is missing, unknown, or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No note exists with the requested ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Note not found"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Notes"
        ],
        "summary": "Delete a note",
        "description": "Deletes and returns the requested note.",
        "operationId": "deleteNote",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "noteId",
            "in": "path",
            "required": true,
            "description": "The MongoDB ObjectId of the note to delete. Validated with mongoose.isValidObjectId.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Note deleted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteResponse"
                }
              }
            }
          },
          "400": {
            "description": "The note ID failed ObjectId validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "The access token is missing, unknown, or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No note exists with the requested ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Note not found"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "patch": {
        "tags": [
          "Notes"
        ],
        "summary": "Update a note",
        "description": "Updates and returns the requested note. Mongoose update validators are not enabled.",
        "operationId": "updateNote",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "noteId",
            "in": "path",
            "required": true,
            "description": "The MongoDB ObjectId of the note to update. Validated with mongoose.isValidObjectId.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateNoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Note updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteResponse"
                }
              }
            }
          },
          "400": {
            "description": "The note ID or request body failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "The access token is missing, unknown, or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No note exists with the requested ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Note not found"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "accessToken",
        "description": "Authentication cookie set by registration or login."
      }
    },
    "schemas": {
      "RegisterUserRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "password123"
          }
        }
      },
      "LoginUserRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": [
          "_id",
          "username",
          "email",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          },
          "username": {
            "type": "string",
            "example": "user@example.com"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-01T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-01T00:00:00.000Z"
          }
        }
      },
      "RefreshResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "Session refreshed"
          }
        }
      },
      "NotesResponse": {
        "type": "object",
        "required": [
          "page",
          "perPage",
          "totalNotes",
          "totalPages",
          "notes"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "perPage": {
            "type": "integer",
            "minimum": 5,
            "maximum": 20,
            "example": 10
          },
          "totalNotes": {
            "type": "integer",
            "minimum": 0,
            "example": 1
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0,
            "example": 1
          },
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoteResponse"
            }
          }
        }
      },
      "NoteResponse": {
        "type": "object",
        "required": [
          "_id",
          "title",
          "content",
          "tag",
          "userId",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          },
          "userId": {
            "type": "string",
            "example": "507f1f77bcf86cd799439012"
          },
          "title": {
            "type": "string",
            "example": "Project planning"
          },
          "content": {
            "type": "string",
            "example": "Prepare the project plan"
          },
          "tag": {
            "type": "string",
            "enum": [
              "Work",
              "Personal",
              "Meeting",
              "Shopping",
              "Ideas",
              "Travel",
              "Finance",
              "Health",
              "Important",
              "Todo"
            ],
            "example": "Work"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-01T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-01T00:00:00.000Z"
          }
        }
      },
      "CreateNoteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Required; leading and trailing whitespace is trimmed.",
            "example": "Project planning"
          },
          "content": {
            "type": "string",
            "description": "Leading and trailing whitespace is trimmed.",
            "default": "",
            "example": "Prepare the project plan"
          },
          "tag": {
            "type": "string",
            "enum": [
              "Work",
              "Personal",
              "Meeting",
              "Shopping",
              "Ideas",
              "Travel",
              "Finance",
              "Health",
              "Important",
              "Todo"
            ],
            "default": "Todo",
            "example": "Work"
          }
        }
      },
      "UpdateNoteRequest": {
        "type": "object",
        "description": "Fields are optional. The route does not enable Mongoose update validators, so model validation rules such as the tag enum are not enforced.",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "example": "Project planning"
          },
          "content": {
            "type": "string",
            "example": "Prepare the project plan"
          },
          "tag": {
            "type": "string",
            "enum": [
              "Work",
              "Personal",
              "Meeting",
              "Shopping",
              "Ideas",
              "Travel",
              "Finance",
              "Health",
              "Important",
              "Todo"
            ],
            "example": "Work"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "InternalServerError": {
        "description": "The app-level error handler encountered an error. In production, the message is replaced by a generic error message.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}
